#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/ {
	/*
	 * Link the RTT control block and buffers into the first 8 kB of AXISRAM1,
	 * which is not used in any other respect. Marked uncached.
	 */
	rtt_ram: memory@34000000 {
		compatible = "zephyr,memory-region";
		reg = <0x34000000 DT_SIZE_K(8)>;
		zephyr,memory-region = "RTT_RAM";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	};

	aliases {
		rtt-custom-section = &rtt_ram;
	};
};

/*
 * Move the SD card's data with SDMMC2's internal DMA rather than by interrupt.
 *
 * The driver leaves the card in its default speed mode, which is rated to
 * 25 MHz, but runs the bus directly from SDMMC2's 48 MHz clock. If a card gives
 * CRC errors, clk-div = <1> brings the bus down to 24 MHz.
 */
&sdmmc2 {
	idma;
};

/* The VENC, which encodes the JPEGs. */
&venc {
	status = "okay";
};

/*
 * Leave the PSRAM uncached. It holds the frames and the JPEGs, and the hardware
 * does nearly all of the reading and writing there. The CPU only writes each
 * JPEG's header and padding, the VENC writing right beside the header.
 */
&psram {
	zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
};
